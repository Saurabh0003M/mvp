# ============================================================================
# Ascend — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Supabase project values.
#
# ALL OF THESE ARE OPTIONAL. With none set, Ascend runs exactly as it always
# has: the recommendation engine is fully client-side and nothing is persisted.
# Setting the two NEXT_PUBLIC_* values turns on anonymous-auth persistence; the
# service-role key is only needed to seed the content corpus from a script.
# ============================================================================

# --- Public (safe to expose to the browser) ---------------------------------
# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key (RLS-scoped; safe in the client bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (NEVER expose to the browser) ------------------------------
# Service-role key. Bypasses Row Level Security — used ONLY for trusted
# server-side tasks such as seeding content_items. Leave blank in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Webz.io article ingest key. Used only by `npm run ingest`; never expose this
# to the browser.
WEBZ_API_KEY=
